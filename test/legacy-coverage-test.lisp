(defun main ()
  (run-legacy-coverage)
  (format t "~%=== Legacy Coverage: Total ~a | Pass ~a | Fail ~a ===~%" *n* *p* *f*)
  (when *fails*
    (format t "Failed keys:~%")
    (dolist (f (reverse *fails*)) (format t "  - ~a~%" f)))
  (sb-ext:exit :code (if (zerop *f*) 0 1)))

(main)
