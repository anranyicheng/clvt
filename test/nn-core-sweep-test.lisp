;;; ------------------------------------------------------------------
;;; P. 组合产物的**形状契约**（数值已在上面逐条钉住，这里只钉形状/秩）
;;; ------------------------------------------------------------------

;; 无符号窄整型的归约累加 dtype：numpy 提升到 uint64，本库提升到 int64
;; （§17.10.24 偏差表：执行层没有 uint64 内核，int64 可无损容纳 uint32 的和；
;; uint64 输入本身不在 11 种逻辑 dtype 里，astype 会报一条说明）。
(let ((r (vt-sum u8)))
  (report "P/u8-sum-dtype" (eq (vt-dtype r) :int64)
          (format nil "dtype=~s" (vt-dtype r)))
  (report "P/u8-sum-value" (= (vt-item r) 575) (format nil "~s" (vt-item r))))

(let ((r (vt-softmax a)))
  (report "P/softmax-rank" (= (length (vt-shape r)) 2)))

(let ((r (vt-matmul (vt-softmax (vt-/ (vt-matmul m (vt-transpose m)) 2d0)) m)))
  (report "P/attention-chain-shape" (equal (vt-shape r) '(4 4))))

(let ((r (vt-tanh (vt-add (vt-matmul m n) c))))
  (report "P/mlp-layer-chain" (equal (vt-shape r) '(4 4))))

;; 归约后 keepdims 必须能直接接广播（NN 里最常见的接缝）
(let* ((mu (vt-mean a :axis -1 :keepdims t))
       (z  (vt-- a mu)))
  (report "P/keepdims-broadcast" (equal (vt-shape z) (vt-shape a))))

;; 链式 matmul 的秩不随中间结果变化
(report "P/chain-matmul-rank"
        (= (length (vt-shape (vt-matmul (vt-matmul m n) m))) 2))


