;;;; nn-core-sweep-test.lisp — AI 计算「汇编级」核心算子的正确性与组合回归
;;;;
;;;; 这一轮的尺子不是「某个函数的边界」，而是**把一张算子清单整张扫一遍**：
;;;; 逐元素算术、一元数学、幂与三角、最值与比较、矩阵乘、卷积、归约、
;;;; 形状搬运、gather/scatter/pad/reverse、类型转换与条件选择、激活函数，
;;;; 以及它们**多层组合**出来的东西（softmax = exp→sum→div、layernorm =
;;;; reduce→rsqrt→affine、attention = matmul→scale→softmax→matmul、
;;;; MLP 层 = matmul→bias→activation、残差 = add∘f）。
;;;;
;;;; 为什么「组合」比「单算子」更能说明问题：NN 里没有一个算子是被孤立
;;;; 使用的，退化路径几乎都出现在接缝处 —— 广播把 (4,) 拉成 (3 4)、
;;;; 归约把 keepdims 打开、激活前先 reshape、`:out` 复用同一块缓冲。
;;;; 单算子对得上而组合对不上，说明契约在两处之间丢了。
;;;;
;;;; 期望值来源：本机 numpy 2.4.6 逐条实测（不是手算），生成脚本见
;;;; /root/work/probe16/sweep.py 的用例表；同一张表在 Lisp 与 numpy 两侧
;;;; 各跑一遍，逐位（ULP）比对 347 条。这里收录其中元素数 ≤ 32 的 201 条，
;;;; 作为不需要 numpy 的常驻回归。
;;;;
;;;; 判据：
;;;;   - 形状与 dtype 精确相等；
;;;;   - 值用 num=（1e-12 相对，带 1 的下限，避免相消放大）。
;;;; 逐位比对（ULP=0）留给差分脚本 —— 那是「今天和昨天一样」，
;;;; 而这里要的是「永远和 numpy 一样」，两者不能互相替代。


(require :asdf)
(defparameter *clvt-test-dir* (make-pathname :name nil :type nil :defaults *load-truename*))
(pushnew (merge-pathnames "../" *clvt-test-dir*) asdf:*central-registry* :test #'equal)
(handler-bind ((warning #'muffle-warning)) (asdf:load-system :clvt))

(in-package :clvt)

;;; ------------------------------------------------------------------
;;; 骨架
;;; ------------------------------------------------------------------

(defvar *pass* 0)
(defvar *fail* 0)
(defvar *failures* '())

(defun report (name ok &optional detail)
  (if ok
      (incf *pass*)
      (progn (incf *fail*) (push name *failures*)
             (format t "~&FAIL ~a ~@[— ~a~]" name detail))))

(defvar *zero-d* 0d0)
(defun nan-p (x) (and (floatp x) (sb-ext:float-nan-p x)))
(defun inf-p (x) (and (floatp x) (sb-ext:float-infinity-p x)))

(defun num= (a b &optional (tol 1d-12))
  (cond ((eq b :nan) (and (floatp a) (nan-p a)))
        ((eq b :inf) (and (floatp a) (inf-p a) (plusp a)))
        ((eq b :-inf) (and (floatp a) (inf-p a) (minusp a)))
        ((and (floatp a) (floatp b))
         (cond ((and (nan-p a) (nan-p b)) t)
               ((or (nan-p a) (nan-p b)) nil)
               ((and (inf-p a) (inf-p b)) (eq (plusp a) (plusp b)))
               (t (<= (abs (- a b)) (* tol (max 1d0 (abs a) (abs b)))))))
        (t (and (realp a) (realp b) (= a b)))))

(defun flat (v) (vt-to-list (vt-ravel v)))

(defun ok-case (name thunk shape dtype want &optional (tol 1d-12))
  (handler-case
      (let ((r (funcall thunk)))
        (report (concatenate 'string name "/shape")
                (equal (vt-shape r) shape)
                (format nil "shape=~s want ~s" (vt-shape r) shape))
        (report (concatenate 'string name "/dtype")
                (eq (vt-dtype r) dtype)
                (format nil "dtype=~s want ~s" (vt-dtype r) dtype))
        (let ((got (flat r)))
          (report (concatenate 'string name "/vals")
                  (and (= (length got) (length want))
                       (every (lambda (x y) (num= x y tol)) got want))
                  (format nil "got ~s want ~s" got want))))
    (error (e)
      (report name nil (format nil "报错: ~a"
                               (substitute #\Space #\Newline (princ-to-string e)))))))

(defun ok-err (name thunk &rest needles)
  (handler-case
      (let ((v (funcall thunk)))
        (report name nil (format nil "没有报错，返回 ~s" (if (vt-p v) (vt-shape v) v))))
    (error (e)
      (let ((msg (princ-to-string e)))
        (report name (every (lambda (n) (search n msg)) needles)
                (format nil "消息:~a" (substitute #\Space #\Newline msg)))))))

